3.Q3. Calculate Grade  Create a stored procedure calculate_grade that accepts 
student ID, student name, and marks and displays the student's grade. Marks 90–100 
Grade A+ 80–89 70–79 A B 60–69 50–59 C D Below 50 F Test 
cases: 
CALL calculate_grade(101, 'Amit', 85); 
CALL calculate_grade(102, 'Priya', 72); CALL calculate_grade(103, 'Rahul', 45); 


delimiter //
create procedure calculate_grade2(In studentid int,studentname varchar(30),marks int)
begin
declare student_grade char(5);

if marks>90 then
set student_grade='A+';

elseif marks>80 then
set student_grade='A';

elseif marks>70 then
set student_grade='B';

elseif marks>60 then 
set student_grade='C';

elseif marks>50 then 
set student_grade='D';

elseif marks<50 then 
set student_grade='F';

else 
select 'Student is Absent' as message;

end if;
SELECT studentid AS Student_ID,
               studentname AS Student_Name,
               marks AS Marks,
               student_grade AS Grade;
end //

