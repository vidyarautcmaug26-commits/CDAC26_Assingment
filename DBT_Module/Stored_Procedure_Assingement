Q5.Find Maximum of Three Numbers — Create a stored procedure find_maximum that accepts three 
integers and displays the largest number. Test cases: CALL find_maximum(25, 78, 45); 
CALL find_maximum(100, 50, 75); CALL find_maximum(30, 30, 20); 

delimiter //
create procedure find_maximum(In a int,b int,c int)

begin
declare max_num int;
if a>=b and a>=c then
set max_num=a;

elseif b>=a and b>=c then
set max_num=b;

else 
set max_num=c;
end if;
select max_num as Maximum_Number;
end //

