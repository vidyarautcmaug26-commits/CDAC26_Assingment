Q2. Calculate Simple Interest  Create a stored procedure calculate_interest that accepts
 principal amount, rate of interest, and time in years and calculates Simple Interest. Simple Interest = (Principal × Rate × Time) / 100 Test cases: CALL calculate_interest(10000, 5, 2); 
CALL calculate_interest(25000, 7, 3); 

delimiter //
create procedure calculate_interest1(In principal_amount decimal(10,2),rate_of_interest int,time_in_year int)
begin 
declare simple_interest decimal(10,2);

set simple_interest=(principal_amount*rate_of_interest*time_in_year)/100;
select simple_interest as Simple_Interest;

