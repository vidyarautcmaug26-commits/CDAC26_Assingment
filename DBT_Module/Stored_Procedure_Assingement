Q7. Electricity Bill Calculation  Create a stored procedure calculate_electricity_bill
 that accepts consumer name and units consumed. Calculate the electricity bill using the slab-wise 
 rates below. Display consumer name, units consumed, and total bill amount. Units First 100 units Rate ₹2 per unit Next
 100 units Next 200 units ₹3 per unit ₹5 per unit ₹7 per unit Above 400 units Test cases: 
 CALL calculate_electricity_bill('Amit', 80); 
 CALL calculate_electricity_bill('Priya', 150); 
 CALL calculate_electricity_bill('Rahul', 350); 
 CALL calculate_electricity_bill('Sneha', 500); 
 
 

DELIMITER //

CREATE PROCEDURE calculate_electricity_bill(
    IN consumer_name VARCHAR(30),
    IN units INT
)
BEGIN
    DECLARE total_bill DECIMAL(10,2);

    IF units <= 100 THEN
        SET total_bill = units * 2;

    ELSEIF units <= 200 THEN
        SET total_bill = (100 * 2)
                       + (units - 100) * 3;

    ELSEIF units <= 400 THEN
        SET total_bill = (100 * 2)
                       + (100 * 3)
                       + (units - 200) * 5;

    ELSE
        SET total_bill = (100 * 2)
                       + (100 * 3)
                       + (200 * 5)
                       + (units - 400) * 7;
    END IF;

    SELECT
        consumer_name AS Consumer_Name,
        units AS Units_Consumed,
        total_bill AS Total_Bill_Amount;
END //

DELIMITER ;

